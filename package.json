{
  "name": "chemtrails",
  "version": "0.1.0",
  "private": true,
  "description": "Renders SMILES chemical notations as crisp SVG diagrams.",
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-plugin-obsidianmd": "latest",
    "globals": "14.0.0",
    "obsidian": "^1.13.0",
    "smiles-drawer": "^2.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1"
  },
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
