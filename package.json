{
  "name": "chemtrails",
  "version": "0.3.0",
  "private": true,
  "description": "Renders SMILES chemical notations as crisp SVG diagrams.",
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "lint:css": "stylelint \"styles.css\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-plugin-obsidianmd": "latest",
    "obsidian": "1.12.3",
    "smiles-drawer": "^2.3.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1"
  },
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
